pipeline {
    agent any

    tools {
        nodejs 'node20'
    }

    environment {
        REPO_URL = 'https://github.com/TU_USUARIO/TU_REPO_PRIVADO.git'
        TG_TOKEN = credentials('telegram-token')
        TG_CHAT  = credentials('telegram-chat-id')
    }

    stages {
        stage('1. Integración al repo privado') {
            steps {
                git branch: 'main',
                    credentialsId: 'git-privado',
                    url: "${REPO_URL}"
                sh 'git log -1 --pretty=format:"Commit: %h - %an - %s"'
            }
        }

        stage('2. Compilación y test') {
            steps {
                sh 'npm ci'
                sh 'npm run build --if-present'
                sh 'npm test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/junit*.xml'
                }
            }
        }

        stage('3. Notificación') {
            steps {
                echo 'Pipeline completado, enviando notificación...'
            }
        }
    }

    post {
        success {
            sh '''
              curl -s -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
                -d chat_id=${TG_CHAT} \
                -d text="ÉXITO: ${JOB_NAME} #${BUILD_NUMBER} - ${BUILD_URL}"
            '''
        }
        failure {
            sh '''
              curl -s -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
                -d chat_id=${TG_CHAT} \
                -d text="FALLÓ: ${JOB_NAME} #${BUILD_NUMBER} - ${BUILD_URL}"
            '''
        }
    }
}
